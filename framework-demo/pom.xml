<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      说明：本示例不继承 spring-boot-starter-parent，而是与框架自身一致地采用
      「BOM import」方式管理依赖版本。这样父 POM 保持中立，便于嵌入到已有项目体系中。
    -->
    <groupId>cn.jowen.framework.demo</groupId>
    <artifactId>framework-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>framework-demo</name>
    <description>基于 framework-boot-starter 的示例应用：数据访问 / 缓存 / 国际化 / 限流 / 脱敏日志 开箱即用</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 框架版本 -->
        <framework.version>0.0.1</framework.version>
        <!-- Spring Boot 版本，与框架根 pom 保持一致 -->
        <spring.boot.version>4.1.0</spring.boot.version>
        <!-- 以下第三方依赖 Spring Boot 4.x BOM 已不再仲裁版本，需显式指定 -->
        <caffeine.version>3.2.4</caffeine.version>
        <h2.version>2.3.232</h2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 依赖仲裁 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
            <!-- 框架 BOM：只锁定框架自身模块版本 -->
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-bom</artifactId>
                <version>${framework.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==================== 框架核心 Starter ==================== -->
        <!-- 引入即获得 framework-core / framework-logger / framework-boot-autoconfigure -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-boot-starter</artifactId>
        </dependency>

        <!-- ==================== 按需能力模块 ==================== -->
        <!-- 数据访问（JDBC 路径：JdbcTemplate / Repository / 事务） -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-data-jdbc</artifactId>
        </dependency>
        <!-- 缓存（CacheManager / Caffeine / 多级缓存） -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-cache</artifactId>
        </dependency>
        <!-- 国际化（MessageSource / LocaleResolver / 热刷新） -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-i18n</artifactId>
        </dependency>
        <!-- 扩展通用能力（限流/幂等/加解密/签名/脱敏/统一返回 Result 等，Web 模块的基础） -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-extras-common</artifactId>
        </dependency>
        <!-- Web 扩展（限流 / 幂等 / 加解密 / 签名 / 验证码 / 操作日志 / 数据权限） -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-boot-web</artifactId>
        </dependency>
        <!-- 文件存储（本地 / MinIO / OSS / S3） -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-extras-storage</artifactId>
        </dependency>
        <!-- 消息（邮件 / 短信 / 站内信 / 钉钉 / 企微 / Webhook） -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-extras-message</artifactId>
        </dependency>

        <!-- ==================== 可选依赖的显式补齐 ==================== -->
        <!-- Caffeine：framework-cache 中为 optional，使用本地缓存时需显式引入 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <!-- ==================== Spring Boot ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== 数据库 ==================== -->
        <!-- H2 内存库，保证零外部依赖开箱即用；切换 MySQL 只需改 application.yml 的 url/driver -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>framework-demo</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!--
              打包可执行 JAR 的插件置于 boot-jar profile 中（默认不激活）。
              原因是该插件不在所有本地仓库中，默认激活会导致离线环境构建失败。
              需要打 fat jar 时执行：mvn package -Pboot-jar
            -->
        </plugins>
    </build>

    <profiles>
        <!-- 打包可执行 JAR：mvn package -Pboot-jar -->
        <profile>
            <id>boot-jar</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring.boot.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>
</project>
