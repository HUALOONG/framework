<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.jowen.framework</groupId>
        <artifactId>framework-data</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>framework-data-jdbc</artifactId>
    <description>framework-data-core 的轻量 JDBC 实现（零 Spring 依赖），封装 SQL 构建执行、结果集映射、连接池、事务与方言，可脱离 Spring 容器独立运行</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 抽象层：提供仓储/事务/方言/映射等契约（传递 framework-core / jspecify） -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-data-core</artifactId>
        </dependency>

        <!-- 日志门面：SQL 日志/性能日志输出 -->
        <dependency>
            <groupId>cn.jowen.framework</groupId>
            <artifactId>framework-logger</artifactId>
        </dependency>

        <!-- 空安全注解（@NullMarked / @Nullable），与 data-core 保持一致 -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- 连接池：HikariCP 为编译期依赖，供 HikariConnectionProvider 直接使用 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!-- Druid 连接池：可选依赖；DruidConnectionProvider 通过反射构造，无 druid 时仍可编译 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Micrometer 2.0 指标（可选）：PerformanceInterceptor 上报 SQL 耗时 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：H2 内存库跑通 CRUD/事务/分页 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试日志实现：framework-logger 的日志实现为 optional，测试需显式引入 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 异步条件等待：替代脆弱的 Thread.sleep + 轮询断言 -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
