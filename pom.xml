<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.jowen.framework</groupId>
    <artifactId>framework</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <description>基于 Spring Boot 4.x + Java 21 的微服务框架脚手架，提供模块化架构、零 Spring 依赖核心与按需装配能力</description>

    <modules>
        <module>framework-bom</module>
        <module>framework-core</module>
        <module>framework-data</module>
        <module>framework-cache</module>
        <module>framework-logger</module>
        <module>framework-i18n</module>
        <module>framework-extras</module>
        <module>framework-plugin</module>
        <module>framework-boot</module>
    </modules>

    <properties>
        <revision>0.0.1</revision>
        <!-- ==================== 构建配置 ==================== -->
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 构建插件版本 -->
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
        <git-commit-id-maven-plugin.version>9.2.0</git-commit-id-maven-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>

        <!-- ==================== 核心框架版本 ==================== -->
        <spring.boot.version>4.1.0</spring.boot.version>
        <spring.cloud.version>2025.1.2</spring.cloud.version>
        <jspecify.version>1.0.0</jspecify.version>
        <mybatis-flex.version>1.11.8</mybatis-flex.version>

        <!-- ==================== 缓存 ==================== -->
        <caffeine.version>3.2.4</caffeine.version>
        <redisson.version>4.7.0</redisson.version>

        <!-- ==================== 对象存储 ==================== -->
        <minio.version>9.0.3</minio.version>
        <aliyun-oss.version>3.18.5</aliyun-oss.version>
        <aws-sdk.version>2.31.0</aws-sdk.version>

        <!-- ==================== 通信服务 ==================== -->
        <angus-mail.version>2.0.4</angus-mail.version>
        <aliyun-sms.version>4.6.0</aliyun-sms.version>
        <dingtalk-sdk.version>2.0.0</dingtalk-sdk.version>
        <workchat-sdk.version>1.0.0</workchat-sdk.version>

        <!-- ==================== 工具库 ==================== -->
        <easyexcel.version>4.0.3</easyexcel.version>
        <ip2region.version>2.7.0</ip2region.version>
        <okhttp.version>4.12.0</okhttp.version>

        <!-- ==================== 连接池 ==================== -->
        <druid.version>1.2.28</druid.version>
        <hikari.version>7.1.0</hikari.version>

        <!-- ==================== 测试工具 ==================== -->
        <h2.version>2.3.232</h2.version>
        <wiremock.version>3.13.2</wiremock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ==================== BOM 导入（最高优先级，统一管理第三方版本） ==================== -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>

            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-dependencies</artifactId>
                <version>${mybatis-flex.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>

            <!-- ==================== 框架内部模块（子模块继承后无需写 version） ==================== -->
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-logger</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-i18n</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-plugin</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 数据访问层 -->
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-data-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-data-jdbc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-data-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 缓存 -->
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-cache</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 扩展功能 -->
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-extras</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-extras-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-extras-message</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-extras-storage</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-extras-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- Boot 自动配置与 Starter -->
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-boot-autoconfigure</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.jowen.framework</groupId>
                <artifactId>framework-boot-starter</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ==================== 缓存（第三方） ==================== -->
            <!-- Caffeine 本地缓存（可选） -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <!-- Redisson 分布式缓存（可选） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ==================== 注解 ==================== -->
            <!-- JSpecify 空安全注解：纯编译期注解，所有模块继承 -->
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

            <!-- ==================== 对象存储 ==================== -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>${aws-sdk.version}</version>
            </dependency>

            <!-- ==================== 通信服务 ==================== -->
            <dependency>
                <groupId>org.eclipse.angus</groupId>
                <artifactId>angus-mail</artifactId>
                <version>${angus-mail.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>dysmsapi20170525</artifactId>
                <version>${aliyun-sms.version}</version>
            </dependency>
            <!-- 钉钉 SDK 坐标暂缺 Maven Central，使用骨架占位；后续集成时替换为 com.dingtalk.open:dingtalk-stream -->
            <!-- 企业微信 SDK 坐标暂缺 Maven Central，使用骨架占位 -->

            <!-- ==================== 工具库 ==================== -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lionsoul</groupId>
                <artifactId>ip2region</artifactId>
                <version>${ip2region.version}</version>
                <optional>true</optional>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>

            <!-- ==================== 连接池 ==================== -->
            <!-- HikariCP 连接池（可选） -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikari.version}</version>
            </dependency>
            <!-- Druid 连接池（可选） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- ==================== 测试 ==================== -->
            <!-- H2：Spring Boot 4.x 已从 BOM 移除版本管理，此处显式仲裁 -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>

            <!-- ==================== process-resources 阶段 ==================== -->
            <!-- flatten-maven-plugin：将 ${revision} 等 CI 友好变量解析为实际值，确保 install/deploy 后的 POM 可被其他项目正常依赖 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ==================== initialize 阶段 ==================== -->
            <!-- git-commit-id-maven-plugin：提取 Git 分支、提交信息， 供 maven-jar-plugin 写入 MANIFEST.MF -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${git-commit-id-maven-plugin.version}</version>
                <configuration>
                    <generateGitPropertiesFile>false</generateGitPropertiesFile>
                    <injectAllReactorProjects>true</injectAllReactorProjects>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.id$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- ==================== package 阶段 ==================== -->
            <!-- maven-jar-plugin：打包 JAR 并将 Git 信息、项目元数据写入 MANIFEST.MF -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!--suppress UnresolvedMavenProperty -->
                            <Git-Branch>${git.branch}</Git-Branch>
                            <!--suppress UnresolvedMavenProperty -->
                            <Git-Commit-Id>${git.commit.id}</Git-Commit-Id>
                            <!--suppress UnresolvedMavenProperty -->
                            <Git-Commit-Id-Abbrev>${git.commit.id.abbrev}</Git-Commit-Id-Abbrev>
                            <!--suppress UnresolvedMavenProperty -->
                            <Git-Commit-Time>${git.commit.time}</Git-Commit-Time>

                            <Project-Name>${project.name}</Project-Name>
                            <Project-Version>${project.version}</Project-Version>
                            <Project-URL>${project.url}</Project-URL>
                        </manifestEntries>
                    </archive>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>

                    <compilerArgs>
                        <arg>-Xlint:deprecation</arg>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </pluginRepository>
    </pluginRepositories>
</project>
