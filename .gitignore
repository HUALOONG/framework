# ============================================================
# Jowen Framework — .gitignore
# ============================================================

# 构建产物
target/

# 编译产物
*.jar
*.war
*.ear
*.class
.flattened-pom.xml

# IDE 配置
.idea/
.vscode/
.settings/
.classpath
.project
.factorypath

# 工具 / 工作区配置
.workbuddy/
.claude/
.mimocode/

# 日志文件
logs/
*.log
*.out

# 临时文件与缓存
temp/
temp-build/
*.swp
*.swo
.DS_Store
.cache/

# 进程 / 调试文件
*.pid
*.hprof
*.dump

# 敏感信息
.env

# 数据库文件
*.db
*.sqlitedb
*.sqlite3

# JRebel
rebel.xml

# Lock 文件
*.lock

# Git worktrees
.worktrees/
